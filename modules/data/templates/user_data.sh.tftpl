#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

apt-get update
apt-get install -y curl gnupg jq awscli

# MongoDB 4.4.18 apt source (Ubuntu 20.04 = focal) — intentionally outdated per exercise
# MongoDB 4.4 reached EOL February 2024; 4.4.18 released 2023
curl -fsSL https://www.mongodb.org/static/pgp/server-4.4.asc | \
  gpg -o /usr/share/keyrings/mongodb-server-4.4.gpg --dearmor
echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-4.4.gpg ] https://repo.mongodb.org/apt/ubuntu focal/mongodb-org/4.4 multiverse" \
  > /etc/apt/sources.list.d/mongodb-org-4.4.list

apt-get update
apt-get install -y \
  mongodb-org=4.4.18 \
  mongodb-org-server=4.4.18 \
  mongodb-org-shell=4.4.18 \
  mongodb-org-mongos=4.4.18 \
  mongodb-org-tools=4.4.18

# Hold to prevent automatic patch upgrades
for pkg in mongodb-org mongodb-org-server mongodb-org-shell mongodb-org-mongos mongodb-org-tools; do
  echo "$pkg hold" | dpkg --set-selections
done

# Initial mongod config without auth so we can create the admin user
cat > /etc/mongod.conf << 'EOF'
storage:
  dbPath: /var/lib/mongodb
systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log
net:
  port: 27017
  bindIp: 0.0.0.0
processManagement:
  timeZoneInfo: /usr/share/zoneinfo
EOF

systemctl enable mongod
systemctl start mongod
sleep 10

# Fetch admin password from Secrets Manager via the instance profile
ADMIN_PASSWORD=$(aws secretsmanager get-secret-value \
  --region ${region} \
  --secret-id ${secret_name} \
  --query SecretString --output text | jq -r '.password')

# Create admin user (MongoDB 4.4 uses 'mongo' shell, not 'mongosh' which is 5.0+)
mongo admin --eval "db.createUser({user: 'admin', pwd: '$ADMIN_PASSWORD', roles: [{role: 'root', db: 'admin'}]})"

# Enable auth and restart
cat >> /etc/mongod.conf << 'EOF'

security:
  authorization: enabled
EOF

systemctl restart mongod

# Backup script — fetches password fresh each run, no plaintext credentials on disk
cat > /usr/local/bin/mongo-backup.sh << 'BACKUP'
#!/bin/bash
set -euo pipefail
REGION="${region}"
SECRET_NAME="${secret_name}"
BACKUP_BUCKET="${backup_bucket}"

MONGO_PWD=$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "$SECRET_NAME" \
  --query SecretString --output text | jq -r '.password')

TS=$(date +%Y%m%d-%H%M%S)
OUT=/tmp/mongo-backup-$TS
mkdir -p "$OUT"
mongodump --uri="mongodb://admin:$MONGO_PWD@localhost:27017/?authSource=admin" --out="$OUT"
tar -czf "$OUT.tar.gz" -C "$OUT" .
aws s3 cp "$OUT.tar.gz" "s3://$BACKUP_BUCKET/backups/"
rm -rf "$OUT" "$OUT.tar.gz"
BACKUP
chmod +x /usr/local/bin/mongo-backup.sh

# Daily backup at 02:00 UTC
echo '0 2 * * * root /usr/local/bin/mongo-backup.sh >> /var/log/mongo-backup.log 2>&1' \
  > /etc/cron.d/mongo-backup
chmod 644 /etc/cron.d/mongo-backup

# Trigger one immediate backup so there's a demo artifact
/usr/local/bin/mongo-backup.sh